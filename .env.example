# Copy this file to .env and fill in your key. Never commit .env.
# ---- Downstream LLM (GroqCloud) ----
GROQ_API_KEY=your-groq-api-key-here
# Production models on Groq as of Oct 2026: openai/gpt-oss-20b (fast, cheap), openai/gpt-oss-120b
GROQ_MODEL=openai/gpt-oss-20b
GROQ_REASONING_EFFORT=low
GROQ_TIMEOUT=30
# ---- Stage 2 guardrail ----
INJECTION_THRESHOLD=0.85
GUARD_MODEL_ID=protectai/deberta-v3-base-prompt-injection-v2
# 0 = let PyTorch decide; set e.g. 4 to pin CPU threads
TORCH_THREADS=0
# ---- Telemetry (shared by gateway and dashboard) ----
TELEMETRY_PATH=logs/telemetry.jsonl
LOG_PREVIEW_CHARS=160
